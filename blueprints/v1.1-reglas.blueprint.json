        },
        {
            "id": 2,
            "module": "builtin:BasicIfElse",
            "version": 1,
            "filter": {
                "name": "Prefiltro: sin respuestas automáticas ni remitentes de sistema",
                "conditions": [
                    [
                        {
                            "a": "{{1.subject}}",
                            "o": "text:notpattern:ci",
                            "b": "respuesta autom[aá]tica|automatic reply|auto-?reply|fuera de (la )?oficina|out of office|delivery status notification|no se pudo entregar|undeliverable"
                        },
                        {
                            "a": "{{1.fromEmail}}",
                            "o": "text:notpattern:ci",
                            "b": "no-?reply|mailer-daemon|postmaster|notifications?@"
                        }
                    ]
                ]
            },
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "Clasificar correo"
                }
            },
            "branches": [
                {
                    "merge": true,
                    "label": "Urgente",
                    "type": "condition",
                    "flow": [
                        {
                            "id": 10,
                            "module": "placeholder:Placeholder",
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": -450
                                }
                            }
                        }
                    ],
                    "conditions": [
                        [
                            {
                                "a": "{{1.subject}} {{1.fullTextBody}}",
                                "o": "text:pattern:ci",
                                "b": "\\b(urge\\b|urgen|emergencia|asap\\b)"
                            }
                        ]
                    ]
                },
                {
                    "merge": true,
                    "label": "Facturación",
                    "type": "condition",
                    "flow": [
                        {
                            "id": 11,
                            "module": "placeholder:Placeholder",
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": -150
                                }
                            }
                        }
                    ],
                    "conditions": [
                        [
                            {
                                "a": "{{1.subject}} {{1.fullTextBody}}",
                                "o": "text:pattern:ci",
                                "b": "\\b(factur|pag[aeéoóu]|cobr[ao]|reembols|cfdi)"
                            }
                        ]
                    ]
                },
                {
                    "merge": true,
                    "label": "Consulta",
                    "type": "condition",
                    "flow": [
                        {
                            "id": 12,
                            "module": "placeholder:Placeholder",
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 150
                                }
                            }
                        }
                    ],
                    "conditions": [
                        [
                            {
                                "a": "{{1.subject}} {{1.fullTextBody}}",
                                "o": "text:pattern:ci",
                                "b": "\\b(duda|consult|pregunt)"
                            }
                        ]
                    ]
                },
                {
                    "merge": true,
                    "disabled": false,
                    "label": "",
                    "type": "else",
                    "flow": [
                        {
                            "id": 13,
                            "module": "placeholder:Placeholder",
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 450
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": 5,
            "module": "builtin:BasicMerge",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0,
                    "name": "Unir clasificación"
                }
            },
            "outputs": [
                {
                    "name": "categoria",
                    "mappings": [
                        "Urgente",
                        "Facturación",
                        "Consulta",
                        "General"
                    ]
                },
                {
                    "name": "prioridad",
                    "mappings": [
                        "Alta",
                        "Media",
                        "Baja",
                        "Baja"
                    ]
                },
                {
                    "name": "plantilla",
                    "mappings": [
                        "<p>Hola,</p><p>Hemos recibido tu mensaje y lo hemos marcado como <strong>Urgente</strong> con prioridad <strong>Alta</strong>. Nuestro equipo lo atenderá lo antes posible.</p><p>Saludos.</p>",
                        "<p>Hola,</p><p>Hemos recibido tu mensaje relacionado con <strong>Facturación</strong> y lo hemos clasificado con prioridad <strong>Media</strong>. Revisaremos tu solicitud y te responderemos pronto.</p><p>Saludos.</p>",
                        "<p>Hola,</p><p>Hemos recibido tu consulta y la hemos clasificado como <strong>Consulta</strong>, con prioridad <strong>Baja</strong>. Nuestro equipo revisará tu mensaje y te responderá pronto.</p><p>Saludos.</p>",
                        "<p>Hola,</p><p>Hemos recibido tu mensaje y lo hemos clasificado como <strong>General</strong>, con prioridad <strong>Baja</strong>. Revisaremos tu solicitud y te responderemos pronto.</p><p>Saludos.</p>"
                    ]
                }
            ],
            "filters": [
                null,
                null,
                null,
                null
            ]
        },
        {
